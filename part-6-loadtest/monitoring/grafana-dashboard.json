      "title": "2. Quote API Latency (P50 / P95 / P99 vs 450ms Alert Threshold)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(quote_api_http_request_duration_seconds_bucket{route=\"/api/quote\"}[1m])))",
          "legendFormat": "P50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(quote_api_http_request_duration_seconds_bucket{route=\"/api/quote\"}[1m])))",
          "legendFormat": "P95 Latency (Threshold: 0.45s)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(quote_api_http_request_duration_seconds_bucket{route=\"/api/quote\"}[1m])))",
          "legendFormat": "P99 Latency",
          "refId": "C"
        }
      ]
    },
