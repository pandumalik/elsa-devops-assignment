      "title": "3. HPA Replica Count (Current vs Desired vs Min/Max)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"quote-api\", horizontalpodautoscaler=\"quote-api\"}",
          "legendFormat": "Current Replicas",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"quote-api\", horizontalpodautoscaler=\"quote-api\"}",
          "legendFormat": "Desired Replicas",
          "refId": "B"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"quote-api\", horizontalpodautoscaler=\"quote-api\"}",
          "legendFormat": "Min Replicas (3)",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": {
